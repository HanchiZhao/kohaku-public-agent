# Kohaku Public Agent environment reference
#
# The application currently does not automatically load .env files.
# Supply these values through PowerShell, the operating-system
# environment, or the deployment environment.
#
# Both variables are optional during normal local development because
# the application provides project-local defaults.

# SQLAlchemy async database URL.
# Default:
# sqlite+aiosqlite:///./runtime/data/public_agent.db
PUBLIC_AGENT_DATABASE_URL=sqlite+aiosqlite:///./runtime/data/public_agent.db

# Directory used by KohakuTerrarium for persistent session files.
# Prefer an absolute path for deployment.
# Example:
# C:\AgentProjects\public-agent-lab\runtime\kohaku_sessions
KT_SESSION_DIR=./runtime/kohaku_sessions